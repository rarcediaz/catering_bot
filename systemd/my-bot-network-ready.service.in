[Unit]
Description=IntelliTrolley Wi-Fi startup gate
Documentation=file://@ROBOT_PACKAGE_DIR@/docs/WIFI_AP_PHASE2.md
Requires=NetworkManager.service
Wants=my-bot-robot.service
After=NetworkManager.service local-fs.target
Before=my-bot-wifi-provisioning.service my-bot-robot.service
ConditionPathExists=/usr/bin/nmcli
ConditionPathExists=@ROBOT_PACKAGE_DIR@/scripts/wifi_startup.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@ROBOT_PACKAGE_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/my-bot-wifi-provisioning
ExecStart=/usr/bin/python3 @ROBOT_PACKAGE_DIR@/scripts/wifi_startup.py
RemainAfterExit=yes
RuntimeDirectory=my-bot-network
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StandardOutput=journal
StandardError=journal
SyslogIdentifier=my-bot-network-ready

[Install]
WantedBy=multi-user.target
