[Unit]
Description=My Bot ROS 2 autonomous robot stack
Documentation=file://@ROBOT_PACKAGE_DIR@/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
ConditionPathExists=@ROBOT_WORKSPACE@/install/setup.bash

[Service]
Type=simple
User=@ROBOT_USER@
Group=@ROBOT_USER@
SupplementaryGroups=dialout
WorkingDirectory=@ROBOT_WORKSPACE@
Environment=HOME=/home/@ROBOT_USER@
Environment=ROBOT_WORKSPACE=@ROBOT_WORKSPACE@
Environment=ROBOT_LAUNCH_FILE=rpi_autonomy.launch.py
Environment=ROBOT_CLEAN_START=true
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file://@ROBOT_WORKSPACE@/install/my_bot/share/my_bot/config/cyclonedds.xml
Environment=RCUTILS_COLORIZED_OUTPUT=0
ExecStart=/usr/bin/bash @ROBOT_PACKAGE_DIR@/scripts/start_robot_stack.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=30
CPUWeight=200
LimitRTPRIO=90
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=my-bot-robot

[Install]
WantedBy=multi-user.target
